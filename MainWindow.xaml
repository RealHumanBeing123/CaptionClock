<Window x:Class="CaptionClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CaptionClock"
        Title="CaptionClock" Height="900" Width="1400" MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#172033" Padding="18,12">
            <DockPanel>
                <TextBlock Text="CaptionClock" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Right" Text="Offline subtitle timing editor" Foreground="#B9C4D8" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" MinWidth="400" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.3*" MinWidth="440" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <Button Content="Open Video" Click="OpenVideo_Click" Padding="14,7" />
                    <TextBlock x:Name="VideoLabel" Text="No video loaded" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#536176" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Border Grid.Row="1" Background="#10141C" CornerRadius="6" ClipToBounds="True">
                    <Grid x:Name="VideoSurface" SizeChanged="CaptionOverlay_SizeChanged">
                        <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                      Stretch="Uniform" MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded" />
                        <Canvas x:Name="CaptionOverlay" Background="Transparent" ClipToBounds="True">
                            <local:OutlinedCaptionText x:Name="CaptionPreview" Visibility="Collapsed"
                                MouseLeftButtonDown="CaptionPreview_MouseLeftButtonDown"
                                MouseMove="CaptionPreview_MouseMove"
                                MouseLeftButtonUp="CaptionPreview_MouseLeftButtonUp" />
                        </Canvas>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <DockPanel Margin="0,0,0,6">
                        <Button x:Name="PlayButton" Content="Play" Click="PlayPause_Click" Padding="14,6" />
                        <TextBlock x:Name="CurrentTimeLabel" Text="00:00:00.000" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" />
                        <TextBlock x:Name="DurationLabel" Text="/ 00:00:00.000" Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" Foreground="#68758A" />
                    </DockPanel>
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" Value="0" ValueChanged="SeekSlider_ValueChanged" />
                    <TextBlock Text="Select a caption to preview it, then drag it over the video to reposition it. During playback, captions follow their timecodes." FontSize="12" Foreground="#68758A" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#D4DAE4" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="Open SRT / VTT / Project" Click="OpenSubtitles_Click" Padding="12,7" Margin="0,0,7,5" />
                    <Button Content="Save / Export As…" Click="SaveAs_Click" Padding="12,7" Margin="0,0,7,5" />
                    <Button Content="Add Caption" Click="AddCaption_Click" Padding="12,7" Margin="0,0,7,5" />
                    <Button Content="Delete" Click="DeleteCaption_Click" Padding="12,7" Margin="0,0,7,5" />
                </WrapPanel>
                <DataGrid x:Name="CaptionGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0" IsReadOnly="False"
                          SelectionChanged="CaptionGrid_SelectionChanged" Background="White" BorderBrush="#D6DCE6"
                          MinRowHeight="42">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Start" Binding="{Binding Start, UpdateSourceTrigger=PropertyChanged}" Width="138" />
                        <DataGridTextColumn Header="End" Binding="{Binding End, UpdateSourceTrigger=PropertyChanged}" Width="138" />
                        <DataGridTemplateColumn Header="Caption text" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Padding="4,3" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                             TextWrapping="Wrap" MinHeight="42" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" Padding="4,3" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="White" BorderBrush="#D6DCE6" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,10,0,0">
                    <StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Font" VerticalAlignment="Center" Margin="0,0,5,6" />
                            <ComboBox x:Name="FontCombo" Width="165" Height="28" Margin="0,0,10,6" SelectionChanged="StyleFont_SelectionChanged" />
                            <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,5,6" />
                            <TextBox x:Name="FontSizeBox" Text="42" Width="48" Height="28" Margin="0,0,8,6" LostFocus="FontSizeBox_LostFocus" KeyDown="FontSizeBox_KeyDown" />
                            <Button Content="Import Font…" Click="ImportFont_Click" Padding="8,4" Margin="0,0,10,6" />
                            <CheckBox x:Name="BoldCheck" Content="Bold" VerticalAlignment="Center" Margin="0,0,9,6" Click="StyleOption_Click" />
                            <CheckBox x:Name="ItalicCheck" Content="Italic" VerticalAlignment="Center" Margin="0,0,9,6" Click="StyleOption_Click" />
                            <CheckBox x:Name="UnderlineCheck" Content="Underline" VerticalAlignment="Center" Margin="0,0,9,6" Click="StyleOption_Click" />
                        </WrapPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Align" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox x:Name="AlignmentCombo" Width="95" Height="27" SelectedIndex="1" Margin="0,0,12,0" SelectionChanged="StyleAlignment_SelectionChanged">
                                <ComboBoxItem Content="Left" />
                                <ComboBoxItem Content="Center" />
                                <ComboBoxItem Content="Right" />
                            </ComboBox>
                            <TextBlock Text="Outline" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox x:Name="OutlineCombo" Width="78" Height="27" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="StyleOutline_SelectionChanged">
                                <ComboBoxItem Content="Black" />
                                <ComboBoxItem Content="White" />
                            </ComboBox>
                            <TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <Slider x:Name="OutlineWidthSlider" Minimum="0" Maximum="6" Value="2.5" Width="82" Height="27"
                                    TickFrequency="0.5" IsSnapToTickEnabled="False" ValueChanged="OutlineWidth_ValueChanged" />
                            <TextBlock Text="Drag caption on video to move it." VerticalAlignment="Center" Foreground="#68758A" FontSize="11" Margin="10,0,0,0" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                    <Button Content="Set Start = Playhead" Click="SetStart_Click" Padding="10,6" Margin="0,0,7,6" />
                    <Button Content="Set End = Playhead" Click="SetEnd_Click" Padding="10,6" Margin="0,0,7,6" />
                    <Button Content="−100 ms" Click="NudgeEarlier_Click" Padding="10,6" Margin="0,0,7,6" />
                    <Button Content="+100 ms" Click="NudgeLater_Click" Padding="10,6" Margin="0,0,7,6" />
                </WrapPanel>
                <TextBlock x:Name="StatusLabel" Grid.Row="4" Text="Open a subtitle file or add a caption to begin." Foreground="#68758A" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
